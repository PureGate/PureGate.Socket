<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Package. Version and the shared metadata are in Directory.Build.props. -->
  <PropertyGroup>
    <PackageId>PureGate.Socket</PackageId>
    <Description>A dependency-free TCP messaging fabric for .NET: multiplexed request/response, events, batches and pull streams over framed TCP, with credit-based flow control, per-connection memory budgets, HMAC and TLS authentication, and System.Diagnostics.Metrics.</Description>
    <PackageTags>tcp;socket;rpc;messaging;streaming;networking;flow-control</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
