<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- RS0026/RS0027 forbid overloads with optional parameters; the API uses them on purpose (optional
         CancellationToken next to timeout overloads). RS0037 asks to record nullability, which this library does
         not use. Every other public-API rule applies. -->
    <NoWarn>$(NoWarn);RS0026;RS0027;RS0037</NoWarn>
  </PropertyGroup>

  <!-- Package. The Publish Nuget Package workflow publishes VersionPrefix. Source Link comes with the SDK, so the symbols map back to this repository. -->
  <PropertyGroup>
    <PackageId>PureGate.Socket</PackageId>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>Ahmed Yasin Koculu</Authors>
    <Copyright>Copyright (c) 2026 Ahmed Yasin Koculu</Copyright>
    <Description>A dependency-free TCP messaging fabric for .NET: multiplexed request/response, events, batches and pull streams over framed TCP, with credit-based flow control, per-connection memory budgets, HMAC and TLS authentication, and System.Diagnostics.Metrics.</Description>
    <PackageTags>tcp;socket;rpc;messaging;streaming;networking;flow-control</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/PureGate/PureGate.Socket</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PureGate/PureGate.Socket.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- The declared public API, checked by the analyzer below. -->
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI\PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI\PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
